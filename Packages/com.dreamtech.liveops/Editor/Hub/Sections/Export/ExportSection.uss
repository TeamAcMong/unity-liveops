/*
 * Màn Xuất JSON (Hình 18, 19, 21). Số đo bám hình [SD2 §3.3]: thân padding 10 · hàng trên card cổng giãn + khối metric
 * 560px · hàng dưới card JSON 520px + cột phải giãn · hai hàng và các card cách nhau 8. Dòng cổng cao 22px, padding 0 8.
 * Hàng diff padding 3 8, hai dòng 11px/10px, tint 0,16 lấy từ token. Bảng lịch sử cột 90 / 110 / giãn / 60, hàng Active
 * viền trái 3px.
 * Mọi màu đi qua token của liveops-hub-theme.uss (hai skin); USS không có gap/:last-child nên khoảng cách dùng margin và
 * class `--last` bật từ C#.
 */

/*
 * TemplateContainer do UXML sinh ra không mang class nào, nên mặc định nó CAO THEO NỘI DUNG. Đo được ở 1440: thân chỉ
 * lấp 628/813px chiều cao dùng được, tức khung cuộn bên trong cũng cao theo nội dung và không bao giờ có thanh cuộn.
 * Gắn flex-grow ngay ở gốc thì cả chuỗi bên dưới (trang → khung cuộn) mới có chiều cao xác định để chia.
 */
.liveops-hub-export-root {
    flex-grow: 1;
}

.liveops-hub-export-page {
    flex-grow: 1;
    padding: var(--liveops-hub-space-10);
}

/*
 * W9-01: thân nằm trong một khung cuộn DỌC (xem chú thích ở ExportSection.uxml). Khung giãn hết cột nội dung, còn thân
 * bên trong cao theo nội dung — đặt flex-grow cho thân thì nó bị ép bằng viewport và khung không bao giờ cuộn.
 */
.liveops-hub-export-scroll {
    flex-grow: 1;
}

.liveops-hub-export-default {
    flex-direction: column;
}

.liveops-hub-export-hidden {
    display: none;
}

/* ---------------------------------------------------------------- Hai hàng bố cục */

.liveops-hub-export-top-row {
    flex-direction: row;
    align-items: stretch;
    flex-shrink: 0;
    margin-bottom: var(--liveops-hub-space-8);
}

.liveops-hub-export-gate-column {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 480px;
    margin-right: var(--liveops-hub-space-8);
}

.liveops-hub-export-metric-host {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 560px;
}

.liveops-hub-export-metric-row {
    flex-direction: row;
    align-items: stretch;
}

.liveops-hub-export-metric--last {
    margin-right: 0;
}

/* (J3-03) Menu đổi định dạng của tile ĐỊNH DẠNG. Giữ "không chữ" theo [SD2 §3.5] — giá trị đã in ở dòng value của tile, đặt
   thêm text là in con số hai lần — nhưng ToolbarMenu không chữ thì thứ mắt nhận được là khung của một ô nhập RỖNG, không
   phải một nút đổi định dạng (phiếu J3-03).
   Ba việc của luật này: (1) align-self: flex-start để menu thôi dãn hết bề ngang thẻ (tile là hộp xếp dọc, align-items mặc
   định là stretch); (2) nền + viền của một NÚT thay vì của một ô nhập — viền đọc cùng token đã đạt bậc hình khối 3:1 ở cả
   hai skin; (3) chừa chỗ cho mũi tên mà không chừa chỗ cho chữ. Bề rộng vì vậy do nội dung quyết (mũi tên + đệm), không
   khai một con số pixel để lần đổi icon nào cũng phải sửa lại. */
.liveops-hub-export-format-menu {
    align-self: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    height: 16px;
    margin: 0;
    padding: 0 2px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--liveops-hub-color-button-border);
    background-color: var(--unity-colors-button-background);
    justify-content: center;
}

.liveops-hub-export-metric-value-row {
    flex-direction: row;
    align-items: flex-end;
    min-height: 22px;
}

.liveops-hub-export-metric-foot-row {
    flex-direction: row;
    align-items: center;
    min-height: 14px;
}

.liveops-hub-export-bottom-row {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
}

.liveops-hub-export-json-column {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 520px;
    margin-right: var(--liveops-hub-space-8);
}

/*
 * W9-01: khung xem JSON là một pane CUỘN RIÊNG cao cố định, không còn giãn theo thân. Vì sao: thân nay nằm trong một
 * khung cuộn dọc, mà trong khung cuộn không có "chiều cao còn lại" để giãn — để nguyên flex-grow thì danh sách dòng JSON
 * dựng HẾT (đo được 508x1040 ở 1920, không một thanh cuộn nào) và kéo cả trang dài thêm gần gấp đôi, đồng thời làm một
 * dòng code có chú thích bị ép còn 200px cho chữ cần 218. Cao cố định thì thanh cuộn của chính pane quay lại làm việc.
 */
.liveops-hub-export-json-host {
    height: 420px;
}

/* Dưới 1100 thân xếp dọc nên pane JSON nhường chỗ cho card diff và bảng lịch sử ngay bên dưới. */
.liveops-hub--medium .liveops-hub-export-json-host {
    height: 300px;
}

.liveops-hub-export-side-column {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
}

/*
 * Cửa sổ dưới 1100 (W9-01, trước đây là dưới 720): JSON trên, diff dưới; cổng trên, metric dưới.
 * Vì sao dời bậc từ --compact lên --medium: cột phải bắt đầu ở x=743 dù cửa sổ rộng bao nhiêu (card JSON 520 + rail +
 * đệm), nên bề rộng CÒN LẠI cho nó là (bề rộng cửa sổ − 743). Đo được: 271px ở 1024 và 3px ở 700 — ô chữ của một hàng
 * diff chỉ còn 97px cho câu cần 225. Dưới 1100 thì cột phải chưa bao giờ đủ rộng để đứng cạnh card JSON; xếp dọc là
 * cách duy nhất không cắt chữ mà cũng không nới ngưỡng nào. Từ 1280 trở lên hai cột vẫn đứng cạnh nhau như thiết kế.
 */

.liveops-hub--medium .liveops-hub-export-bottom-row {
    flex-direction: column;
}

.liveops-hub--medium .liveops-hub-export-json-column {
    flex-basis: auto;
    margin-right: 0;
    margin-bottom: var(--liveops-hub-space-8);
}

.liveops-hub--medium .liveops-hub-export-top-row {
    flex-direction: column;
}

.liveops-hub--medium .liveops-hub-export-gate-column {
    flex-basis: auto;
    margin-right: 0;
    margin-bottom: var(--liveops-hub-space-8);
}

.liveops-hub--medium .liveops-hub-export-metric-host {
    flex-basis: auto;
}

/* Cửa sổ hẹp (< 900): metric 2×2 — flex-wrap, mỗi tile nửa hàng. */

.liveops-hub--narrow .liveops-hub-export-metric-row {
    flex-wrap: wrap;
}

.liveops-hub--narrow .liveops-hub-export-metric-row > .liveops-hub-metric {
    flex-basis: 45%;
}

/* ---------------------------------------------------------------- Nút header có icon, lý do cạnh nút */

/*
 * Button LÀ TextElement: `Button.text` do chính nút vẽ trên cả hộp nội dung nên Image con CHỒNG lên chữ ("Co[icon] JSON").
 * Nút bỏ text, xếp Image rồi Label thành hàng — [FD §2.12]: icon margin-left −2, margin-right 4, flex-shrink 0.
 * Sheet này được nạp thẳng lên từng slot ở PopulateHeaderActions vì nút sống trong section header của shell (cây khác thân màn).
 */
.liveops-hub-export-icon-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.liveops-hub-export-icon-button-icon {
    margin-left: -2px;
    margin-right: 4px;
    flex-shrink: 0;
}

.liveops-hub-export-icon-button-label {
    margin: 0;
    padding: 0;
}

/* Lý do cạnh nút ở mức quiet — (b) "Còn thiếu cho Đánh dấu…" và (f) "Không có thay đổi để ghi" không phải chữ chặn. */
.liveops-hub-button-reason.liveops-hub-export-reason-quiet {
    color: var(--liveops-hub-color-quiet);
}

/* Nút không phải nút mang lý do: chỉ tooltip, không in chữ (ba chữ cạnh nhau trên header sẽ chồng lên nhau). */
.liveops-hub-button-slot--blocked > .liveops-hub-button-reason.liveops-hub-export-reason-tooltip-only {
    display: none;
}

/* ---------------------------------------------------------------- Card: tiêu đề, meta */

/*
 * Header card ở 1280 phải co được: tiêu đề và meta XUỐNG DÒNG (W9-01, trước đây rút bằng "…"), hàng chip KHÔNG co (chip
 * thứ tư "Giữ 3" là số người đọc cần). Thiếu min-width:0 thì flex-shrink không có tác dụng trên phần tử có chữ, nên meta
 * bị cắt giữa chữ và chip tràn ra ngoài card.
 * Vì sao bỏ ellipsis: meta của card Các lần đã đăng là danh sách LỆNH ("chuột phải: So với nháp · Khôi phục vào nháp…")
 * — rút đi là giấu mất lệnh, người dùng không có đường nào khác biết chúng tồn tại.
 */
.liveops-hub-export-card-title {
    -unity-font-style: bold;
    font-size: 11px;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.liveops-hub-export-card-meta {
    font-size: 10px;
    opacity: 0.82;
    margin-left: var(--liveops-hub-space-6);
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

/*
 * Header card của màn này cao THEO NỘI DUNG (sàn 24px) và cho xuống dòng: tiêu đề + meta + hàng chip của card diff cộng
 * lại dài hơn một dòng ở mọi cỡ dưới 1280. Khoá cứng 24px như mặc định thì phần dư bị cắt mất.
 */
.liveops-hub-export-page .liveops-hub-card-header {
    height: auto;
    min-height: 24px;
    flex-wrap: wrap;
    align-content: center;
    padding-top: 3px;
    padding-bottom: 3px;
}

.liveops-hub-export-card-spacer {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- Card Cổng xuất */

/*
 * W9-01: cao theo nội dung với sàn 22px. Câu của một dòng cổng là một KẾT LUẬN ("Parser của game xác nhận: giữ 6/8 mục,
 * bỏ 2") — đo được 288px (vi) / 378px (en) trong ô 273px ngay ở 1280, nên nó cần xuống dòng chứ không phải chỗ rộng hơn.
 */
.liveops-hub-export-gate-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    padding: 2px var(--liveops-hub-space-8);
}

.liveops-hub-export-gate-row--clickable {
    cursor: link;
}

.liveops-hub-export-gate-row--running {
    border-top-width: 1px;
    border-top-color: var(--unity-colors-window-border);
}

.liveops-hub-export-gate-row-text {
    font-size: 11px;
    margin-left: var(--liveops-hub-space-8);
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.liveops-hub-export-gate-row-meta {
    font-size: 10px;
    opacity: 0.82;
    margin-left: var(--liveops-hub-space-8);
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.liveops-hub-export-gate-row-spacer {
    flex-grow: 1;
}

.liveops-hub-export-gate-compact-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 var(--liveops-hub-space-8);
}

.liveops-hub-export-gate-compact-remote {
    font-size: 10px;
    opacity: 0.82;
    margin-left: var(--liveops-hub-space-8);
}

/* ---------------------------------------------------------------- Card lỗi (h), note (i) */

.liveops-hub-export-failure-card {
    margin-bottom: var(--liveops-hub-space-8);
    border-left-width: 3px;
    border-left-color: var(--liveops-hub-color-blocked-fill);
}

.liveops-hub-export-failure-symptom {
    font-size: 11px;
    white-space: normal;
}

.liveops-hub-export-failure-message {
    font-size: 11px;
    white-space: normal;
    margin-top: var(--liveops-hub-space-4);
}

.liveops-hub-export-failure-position {
    font-size: 10px;
    opacity: 0.82;
    margin-top: var(--liveops-hub-space-2);
}

.liveops-hub-export-failure-actions {
    flex-direction: row;
    align-items: center;
    margin-top: var(--liveops-hub-space-6);
}

.liveops-hub-export-restoring-note {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--liveops-hub-space-8);
}

/*
 * Chữ chân màn (class chung .liveops-hub-note là một HÀNG, không phải ô chữ) — mặc định của UI Toolkit là không xuống
 * dòng, nên câu 510px này bị cắt ngay ở 1280. W9-01: cho xuống dòng.
 */
#export-footer-note {
    white-space: normal;
}

/* ---------------------------------------------------------------- Card diff */

.liveops-hub-export-diff-chip-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.liveops-hub-export-diff-group {
    flex-direction: column;
}

.liveops-hub-export-diff-group--later {
    border-top-width: 1px;
    border-top-color: var(--unity-colors-window-border);
    margin-top: var(--liveops-hub-space-4);
    padding-top: var(--liveops-hub-space-4);
}

.liveops-hub-export-diff-group-header {
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.82;
    padding: 0 var(--liveops-hub-space-8);
}

.liveops-hub-export-diff-row {
    flex-direction: row;
    align-items: center;
    padding: 3px var(--liveops-hub-space-8);
}


.liveops-hub-export-diff-row--dropped {
    background-color: var(--liveops-hub-color-blocked-tint);
}

.liveops-hub-export-diff-row--progress-lost {
    background-color: var(--liveops-hub-color-warning-tint);
}

.liveops-hub-export-diff-symbol {
    font-size: 14px;
    -unity-font-style: bold;
    width: 14px;
}

.liveops-hub-export-diff-row-text {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: var(--liveops-hub-space-6);
}

/* Tag "bắt buộc" đứng sau tên đợt: cho xuống dòng thay vì thò ra khỏi ô (đo được [phải 61, trái −97] ở 1024). */
.liveops-hub-export-diff-row-title {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    font-size: 11px;
}

/*
 * Dòng tên đợt của một hàng diff ("hunt-0914 chồng giờ với lava-quest-2026-09b") là Label KHÔNG mang class riêng — nó do
 * ExportDiffCard dựng thẳng. Chọn theo kiểu phần tử để nó xuống dòng; đây là chỗ duy nhất trong màn có Label trần nằm
 * trực tiếp trong hàng tiêu đề, nên selector không với sang đâu khác.
 */
.liveops-hub-export-diff-row-title > Label {
    white-space: normal;
}

.liveops-hub-export-diff-row-consequence {
    font-size: 10px;
    opacity: 0.82;
    white-space: normal;
}

.liveops-hub-export-diff-row-action {
    flex-shrink: 0;
    margin-left: var(--liveops-hub-space-6);
}

.liveops-hub-export-diff-empty {
    font-size: 11px;
    opacity: 0.82;
    white-space: normal;
    padding: var(--liveops-hub-space-6) var(--liveops-hub-space-8);
}

/* ---------------------------------------------------------------- Card Các lần đã đăng */

.liveops-hub-export-history-table {
    flex-direction: column;
}

.liveops-hub-export-history-head-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
    padding: 0 var(--liveops-hub-space-8);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.liveops-hub-export-history-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    /* Padding trái 5 + sọc 3 của liveops-hub-row--active = 8: chữ không xê dịch giữa hàng có và không có sọc. */
    padding: 0 var(--liveops-hub-space-8) 0 5px;
    border-left-width: 3px;
    border-left-color: var(--unity-colors-window-background);
}

.liveops-hub-export-history-cell {
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.liveops-hub-export-history-cell--time {
    width: 90px;
    flex-shrink: 0;
}

.liveops-hub-export-history-cell--publisher {
    width: 110px;
    flex-shrink: 0;
}

/*
 * Ô Ghi chú mang hai mẩu: ghi chú của lần đăng và hậu tố "· đang là bản so". W9-01: cho XUỐNG DÒNG thay vì cắt — đo được
 * hậu tố thò 125px ra ngoài ô ở 1280 tiếng Anh, và nó là chỗ duy nhất nói hàng nào đang được dùng làm bản so.
 */
.liveops-hub-export-history-cell--note {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.liveops-hub-export-history-cell--sha {
    width: 60px;
    flex-shrink: 0;
}

.liveops-hub-export-history-verified {
    font-size: 10px;
    opacity: 0.7;
    margin-left: var(--liveops-hub-space-4);
}

.liveops-hub-export-history-verified-mark {
    margin-left: var(--liveops-hub-space-4);
    flex-shrink: 0;
}

.liveops-hub-export-history-active-suffix {
    font-size: 10px;
    opacity: 0.7;
    margin-left: var(--liveops-hub-space-4);
}
