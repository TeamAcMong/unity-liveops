/*
 * liveops-hub-controls.uss — control dùng chung của LiveOps Hub: ô ngày giờ UTC, tab tự làm, thanh chu kỳ, JSON viewer, cắt giữa chữ
 * dài ([FD §2.6, §2.15, §2.16], [SD1 §4.1], [SD2 §3.6]). Nạp sau feedback, trước timeline và motion.
 *
 * Luật: không màu trần (token theme hoặc --unity-colors-*), không gap/:last-child/:nth-child/@media/grid/box-shadow. Element tự vẽ
 * (JSON view, cycle bar) KHAI LẠI token trên selector của chính nó bằng var(): custom property không kế thừa từ root, customStyle của
 * element chỉ thấy thuộc tính khai trên rule khớp chính nó ([API §12.2]; test ControlsSkinTokenTests).
 */

/* ---------------------------------------------------------------- Ô ngày giờ UTC — ô ngày 88 · ô giờ 44 · "UTC" 10px 0,7
   Hai hàng: hàng GIÁ TRỊ (ngày + giờ + "UTC") và DÒNG LỖI (biểu tượng 12px + câu lỗi). Biểu tượng ở dòng lỗi chứ không cuối
   hàng giá trị — W9-30, xem chú thích của LiveOpsUtcDateTimeField. */

.liveops-hub-utc-field {
    flex-shrink: 0;
}

.liveops-hub-utc-field__input {
    flex-direction: column;
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.liveops-hub-utc-field__row {
    flex-direction: row;
    align-items: center;
}

.liveops-hub-utc-field__date,
.liveops-hub-utc-field__time {
    flex-shrink: 0;
    margin: 0;
}

/* (W9-19) 76 → 88px. Vì sao nới: chữ mono "2026-09-10" đo 75px ở 2022.3 (73px ở 6000.6), nên ô 76px chỉ dư 0,5px mỗi bên SAU
   KHI lượt trước đã nhường hết đệm ngang — một đổi metric font (bản Unity khác, DPI khác, cỡ chữ Editor khác) là cắt lại mà
   không ai thấy.
   Con số 88 đo ra chứ không ước: vùng NỘI DUNG của TextInput = bề rộng ô − 8px đệm ([SD1] pin "padding 0 4") − 2px viền của
   chính TextInput. 88 ⇒ 78px nội dung cho chữ 75px, dư 1,5px mỗi bên ở bản Unity chật hơn trong hai bản. Phiếu W9-19 đề nghị
   dải 80–84 khi chưa trừ 2px viền ấy: 84 cho đúng 74px nội dung, tức CHẬT HƠN chữ của 2022.3 — đo được ở lượt 6000.6 ngày
   20/9 (test UtcField_DateInput_KeepsSlackForTheLongestDateText báo "cần 73px, chỗ có 74px").
   Hàng Bắt đầu/Kết thúc trong pane 280px vẫn đủ chỗ: nhãn 96 + ô 88 + 4 + ô giờ 44 + 4 + "UTC". Hai test khoá con số này đổi
   theo trong cùng lượt. */
.liveops-hub-utc-field__date {
    width: 88px;
}

.liveops-hub-utc-field__time {
    width: 44px;
    margin-left: var(--liveops-hub-space-4);
}

/* (W9-19) Đệm ngang của ô NGÀY trở lại đúng "padding 0 4" mà [SD1 §3.1] pin cho ô nhập: lượt trước phải bỏ nó để chữ 75px vừa
   trong ô 76px (RC-02), nay ô rộng 88 nên đệm về lại được mà chữ vẫn không chạm mép.
   Ô GIỜ giữ đệm ngang 0: "12:00" cũng là chữ mono và ô pin 44px, nên 4+4 đệm chỉ còn 36px cho chữ — trả đệm ở đó là dựng lại
   đúng chỗ cắt mà lượt trước vừa dẹp. Nới ô giờ là đổi một con số [SD1] khác, ngoài phạm vi W9-19: khai thành nợ, không tự
   nới. Đệm DỌC của cả hai ô giữ nguyên. */
.liveops-hub-utc-field__date > .unity-text-field__input {
    margin: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.liveops-hub-utc-field__time > .unity-text-field__input {
    margin: 0;
    padding-left: 0;
    padding-right: 0;
}

/* Lỗi: viền blocked-fill trên đúng ô không đọc được — chữ gõ giữ nguyên ([FD §2.16] hàng Field). */
.liveops-hub-utc-field__part--error > .unity-text-field__input {
    border-left-color: var(--liveops-hub-color-blocked-fill);
    border-right-color: var(--liveops-hub-color-blocked-fill);
    border-top-color: var(--liveops-hub-color-blocked-fill);
    border-bottom-color: var(--liveops-hub-color-blocked-fill);
}

.liveops-hub-utc-field__zone {
    font-size: 10px;
    opacity: 0.7;
    margin-left: var(--liveops-hub-space-4);
    padding: 0;
    /* "UTC" là ba chữ cố định và là thứ nói giá trị trong ô là giờ nào: chỗ chật thì cắt ô khác, không bao giờ cắt nó (C3). */
    flex-shrink: 0;
}

/* (W9-30) Biểu tượng lỗi đứng ĐẦU DÒNG LỖI chứ không cuối hàng giá trị, nên lề đổi sang phải và nó bám MÉP TRÊN của câu:
   câu lỗi dài ba dòng trong pane 280px, căn giữa theo trục dọc thì biểu tượng trôi xuống giữa đoạn văn. */
.liveops-hub-utc-field__error-icon {
    margin-right: var(--liveops-hub-space-4);
    margin-top: var(--liveops-hub-space-2);
    align-self: flex-start;
}

.liveops-hub-utc-field__device-line {
    font-size: 10px;
    opacity: 0.82;
    padding: 0;
    margin-top: var(--liveops-hub-space-2);
}

/* Dòng lỗi 10px; chữ blocked-text từ class liveops-hub-text--blocked (opacity 1).
   (W9-30) Câu lỗi nay đứng cạnh biểu tượng trong MỘT hàng: phải co được và min-width 0, kẻo bề rộng một dòng của câu đẩy
   chính nó ra ngoài cột field thay vì xuống dòng. */
.liveops-hub-utc-field__error {
    font-size: 10px;
    padding: 0;
    margin-top: var(--liveops-hub-space-2);
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
}

.liveops-hub-utc-field--hidden {
    display: none;
}

/* ---------------------------------------------------------------- Tab tự làm (Toolbar + ToolbarToggle loại trừ nhau) */

.liveops-hub-tab-strip {
    flex-shrink: 0;
}

.liveops-hub-tab-strip__slot {
    flex-direction: row;
    flex-shrink: 0;
}

/* margin-left: 0 là bắt buộc, không phải trang trí: 2022.3 cho ToolbarToggle lề trái ÂM 2px (mẹo cho nút toolbar dính viền
   nhau), nên tab thò 2px ra ngoài __slot ở mọi cỡ rộng (RC-10). 6000.6 vốn đã 0 nên luật này không đổi gì ở đó. */
.liveops-hub-tab-strip__tab {
    flex-shrink: 0;
    margin-left: 0;
}

/* Lý do tab bị khoá in thành chữ ngay bên trái tab (SPIKE-B SP-3) — cùng số đo với .liveops-hub-button-reason của nút bị chặn.
   Ẩn bằng display:none khi tab mở để không chiếm chỗ; USS không có :disabled cho element cha nên class do C# bật. */
.liveops-hub-tab-strip__reason {
    display: none;
    font-size: 10px;
    margin-right: 4px;
    -unity-text-align: middle-right;
}

.liveops-hub-tab-strip__slot--blocked > .liveops-hub-tab-strip__reason {
    display: flex;
}

/* ---------------------------------------------------------------- Thanh chu kỳ — cao 14, viền, bo 2; con chia bằng flex-grow (C#) */

.liveops-hub-cycle-bar {
    --liveops-hub-cycle-bar-period-end: var(--liveops-hub-color-now);
    flex-direction: row;
    height: 14px;
    flex-shrink: 0;
    border-width: 1px;
    border-radius: 2px;
    border-color: var(--unity-colors-window-border);
    overflow: hidden;
}

.liveops-hub-cycle-bar__run,
.liveops-hub-cycle-bar__rest,
.liveops-hub-cycle-bar__overflow {
    flex-basis: 0;
    flex-shrink: 1;
}

/* Phần nghỉ: nền input để "nghỉ" đọc được là khoảng trống chứ không phải thiếu dữ liệu. */
.liveops-hub-cycle-bar__rest {
    background-color: var(--unity-colors-input_field-background);
}

.liveops-hub-cycle-bar__part--hidden {
    display: none;
}

/* ---------------------------------------------------------------- JSON viewer — dòng 16 · số dòng 32 · lề 14 · dải tổng quan 10 */

.liveops-hub-json-view {
    --liveops-hub-json-view-key: var(--liveops-hub-json-key);
    --liveops-hub-json-view-string: var(--liveops-hub-json-string);
    --liveops-hub-json-view-number: var(--liveops-hub-json-number);
    --liveops-hub-json-view-literal: var(--liveops-hub-json-literal);
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.liveops-hub-json-view__tabs {
    height: 18px;
}

.liveops-hub-json-view__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    background-color: var(--unity-colors-input_field-background);
}

.liveops-hub-json-view__list {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.liveops-hub-json-line {
    flex-direction: row;
    align-items: center;
    height: 16px;
}

.liveops-hub-json-line--blocked {
    background-color: var(--liveops-hub-color-blocked-tint);
}

.liveops-hub-json-line--warning {
    background-color: var(--liveops-hub-color-warning-tint);
}

.liveops-hub-json-line-number {
    width: 32px;
    flex-shrink: 0;
    padding: 0 6px 0 0;
    margin: 0;
    font-size: 10px;
    opacity: 0.7;
    -unity-text-align: middle-right;
}

.liveops-hub-json-gutter {
    width: 14px;
    height: 16px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.liveops-hub-json-gutter-mark {
    padding: 0;
    margin: 0;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.liveops-hub-json-code {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 0;
    margin: 0;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.liveops-hub-json-annotation {
    flex-shrink: 0;
    padding: 0;
    margin: 0 4px 0 8px;
    font-size: 10px;
    -unity-text-align: middle-left;
}

.liveops-hub-json-view__part--hidden {
    display: none;
}

/* Dải tổng quan: nền default, viền trái 1; vạch khác nhau cả hình dạng — bị bỏ full 3px, cảnh báo nửa phải 2px, thay đổi nửa trái 1px. */
.liveops-hub-json-overview {
    width: 10px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-window-border);
    background-color: var(--unity-colors-default-background);
}

.liveops-hub-json-overview-marker {
    position: absolute;
}

.liveops-hub-json-overview-marker--dropped {
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--liveops-hub-color-blocked-fill);
}

.liveops-hub-json-overview-marker--warning {
    left: 50%;
    right: 0;
    height: 2px;
    background-color: var(--liveops-hub-color-warning-fill);
}

.liveops-hub-json-overview-marker--change {
    left: 0;
    right: 50%;
    height: 1px;
    opacity: 0.8;
    background-color: var(--unity-colors-default-text);
}

.liveops-hub-json-overview-viewport {
    position: absolute;
    left: 0;
    right: 0;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-default-text);
    opacity: 0.8;
}

/* ---------------------------------------------------------------- Cắt giữa chữ dài (SP-6: USS là đường chính, hai bản) */

.liveops-hub-text--elide-middle {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: middle;
}
