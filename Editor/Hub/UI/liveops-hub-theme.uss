/*
 * liveops-hub-theme.uss — token hai skin của LiveOps Hub ([FD §2.1–§2.8], kế hoạch 8.10). Nạp ĐẦU TIÊN vào root clone.
 *
 * Vì sao token riêng thay cho --unity-colors-error-text/warning-text: error-text Dark #D32222 trên #383838 chỉ 2,24:1,
 * Light error-text/warning-text gần đen nên dấu trạng thái không nổi ([FD §2.3]). Mọi màu nền/viền khác dùng thẳng
 * biến Unity để tự đổi theo skin.
 *
 * Skin: token khai trên .liveops-hub-root (Dark), ghi đè trong .liveops-hub-root.liveops-hub--skin-light. Không @media,
 * không tháo/gắn sheet lúc chạy — C# chỉ bật class skin khi probe --liveops-hub-skin-probe đổi (CustomStyleResolvedEvent).
 *
 * Custom property KHÔNG kế thừa ([API §12.2]): element tự vẽ (lane, minimap, JSON view, cycle bar) khai lại token trên
 * selector của chính nó bằng var() — không đọc thẳng token của root qua customStyle.
 *
 * Đây là file DUY NHẤT được ghi màu trần (uss-lint.py chặn ở file khác).
 */

.liveops-hub-root {
    /* Probe skin: đọc lại màu nền cửa sổ để biết Unity đã đổi Theme khi hub không có focus. */
    --liveops-hub-skin-probe: var(--unity-colors-window-background);

    /* Trạng thái — Dark ([FD §2.3], tương phản đo trên nền thật). */
    /* (W10-06) #FF8080 cũ đạt 4,83:1 khi đứng một mình trên cửa sổ #383838, nhưng câu lỗi nào nằm trong một khối có
       opacity 0,82-0,85 (dòng chân thẻ số đo, dòng lỗi màn Xuất JSON / Kiểm lịch) thì màu ĐÃ HỢP THÀNH chỉ còn
       3,75-3,92:1. Nâng hai kênh lục/lam 128 → 172 (giữ nguyên kênh đỏ 255, tức giữ nguyên tông đỏ, chỉ sáng hơn):
       hợp thành × 0,82 đo ra 4,97:1 trên nền cửa sổ và 4,71:1 trên nền thẻ #3C3C3C. */
    --liveops-hub-color-blocked-text: #FFACAC;
    --liveops-hub-color-blocked-fill: #F05454;
    --liveops-hub-color-warning-text: #F4BC02;
    --liveops-hub-color-warning-fill: #F4BC02;
    /* Quiet là màu CHỮ phụ (không phải vòng rỗng): dùng khắp hub, kể cả tag lý do của popover Thêm đợt, nên phải theo bậc
       chữ thường 4,5:1 của WCAG. #949494 cũ chỉ 3,87:1 trên cửa sổ #383838; #A3A3A3 đo ra 4,65:1 (G-UX3-TIMELINE §2.1) —
       và W10 nâng tiếp một nấc nữa, lý do ngay dưới. */
    /* (W10-06) #A3A3A3 đo 4,65:1 trên nền CỬA SỔ #383838 nhưng số đếm của thẻ Tổng quan nằm trên nền THẺ #3C3C3C sáng
       hơn, ở đó chỉ còn 4,37:1. #AAAAAA đo ra 4,75:1 trên nền thẻ và 5,05:1 trên nền cửa sổ — vẫn là xám trung tính
       cùng tông, chỉ nâng đúng ba nấc cần để qua bậc chữ thường. */
    --liveops-hub-color-quiet: #AAAAAA;
    /* (W10-09) Viền của swatch "loại chưa khai báo". Vì sao KHÔNG dùng lại --liveops-hub-color-quiet: swatch ấy nằm trong
       một ô mang .liveops-hub-event-types-row--undeclared (opacity 0,7), và opacity của tổ tiên NHÂN xuống — viền là hình
       khối nên phải đạt bậc 3:1 SAU khi nhân. Ở skin tối quiet × 0,7 trên nền cửa sổ #383838 hợp thành #888888 = 3,30:1,
       vẫn đạt, nên giá trị ở đây bằng đúng quiet; token vẫn tách riêng để lần sau ai chỉnh quiet (màu CHỮ, bậc 4,5:1)
       không vô tình kéo viền hình khối xuống dưới 3:1 mà không ai báo. Skin sáng phải lệch hẳn — xem khối skin sáng. */
    --liveops-hub-color-undeclared-border: #AAAAAA;
    /* (W10-06) Màu CHỮ nền tảng của hub. Vì sao thành token thay vì dùng thẳng --unity-colors-default-text: chữ phụ khắp
       hub (caption thẻ, dòng chân thẻ, dòng meta status bar) là chữ nền tảng NHÂN opacity 0,7 của khối cha, và
       #D2D2D2 của Unity × 0,7 hợp thành ra #A5A5A5 trên nền thẻ #3C3C3C — 4,48:1, thiếu 0,02 so với bậc chữ thường.
       Sửa ở opacity thì phải sửa rải rác ở hàng chục luật USS của mọi màn; sửa ở màu gốc thì một token lo hết.
       #D7D7D7 × 0,7 hợp thành ra 4,67:1 trên nền thẻ #3C3C3C, 4,89:1 trên nền cửa sổ #383838 và 5,81:1 trên nền
       chip #282828. Vẫn là xám trung tính của Unity, chỉ sáng hơn năm nấc.
       Ba số trên tính ĐÚNG như UxLayoutAuditor tính: hợp thành source-over bằng số thực, KHÔNG làm tròn về 8 bit
       giữa chừng. Làm tròn màu hợp thành về hex trước rồi mới tính thì ra 4,64 / 4,87 / 5,84 — lệch tới 0,03 và
       KHÔNG phải phép đo mà cổng chạy, nên đừng trộn hai lối tính trong cùng một câu. */
    --liveops-hub-color-text: #D7D7D7;
    --liveops-hub-color-focus: #7BAEFA;
    /* Link không dùng --unity-colors-link-text (#4C7EFF chỉ 3,20:1 trên #383838). */
    --liveops-hub-color-link: #7BAEFA;
    --liveops-hub-color-now: #E6E6E6;
    --liveops-hub-color-on-selection: #FFFFFF;
    /* Tint nền dòng lỗi/cảnh báo = fill × 0,16 — USS không nhân alpha vào var() nên khai sẵn màu có alpha. */
    --liveops-hub-color-blocked-tint: rgba(240, 84, 84, 0.16);
    --liveops-hub-color-warning-tint: rgba(244, 188, 2, 0.16);
    /* Nền mờ palette: giá trị cố định cho hai skin ([FD §2.2]) — khai ở đây để sheet feedback không ghi màu trần. */
    --liveops-hub-scrim-color: rgba(0, 0, 0, 0.45);

    /* Tám màu loại event ([FD §2.5]) — không đỏ/cam/vàng/xanh lá thuần để không lẫn màu sức khoẻ. */
    --liveops-hub-event-color-0: #5096DE;
    --liveops-hub-event-color-1: #2FB5C8;
    --liveops-hub-event-color-2: #3BAA8F;
    --liveops-hub-event-color-3: #8288E6;
    --liveops-hub-event-color-4: #AD7BE0;
    --liveops-hub-event-color-5: #D06BB8;
    --liveops-hub-event-color-6: #7F9BB3;
    --liveops-hub-event-color-7: #B88A9E;

    /* Dấu màu chú giải trục [SD1 §3.6] — thang ba bậc TRUNG TÍNH riêng (G-UX3-TIMELINE, phương án B của UX-PASS3 §2.3).
       Vì sao không dùng lại màu của chính thanh: ở skin tối thanh vẽ bằng --unity-colors-button-background #585858 (1,65:1),
       thanh lặp #3C3C3C (1,06:1) và thanh đã khép #383838 (1,00:1 — ĐÚNG BẰNG nền, dấu vô hình). Viền 1px
       --unity-colors-button-border #303030 chỉ 1,13:1 nên viền không cứu được bậc 3:1 của hình khối, phải chốt về phía NỀN
       của dấu. Ở skin tối mọi màu tối hơn nền đều không thể đạt 3:1 (trần với màu đen là 1,79:1), nên dấu buộc phải SÁNG hơn
       nền — dấu là bản ÂM của thanh, và mọi nét vẽ trên dấu lấy màu nền cửa sổ (xem liveops-hub-timeline.uss).
       Giữ nguyên thứ hạng sáng → tối của thanh thật (thường > lặp > đã khép), ba bậc cách nhau 1,36–1,50 lần nên vẫn
       phân biệt được, và mỗi mục còn có vạch/gạch riêng cùng nhãn chữ bên cạnh. */
    --liveops-hub-legend-fixed: #C4C4C4;
    --liveops-hub-legend-recurring: #A8A8A8;
    --liveops-hub-legend-ended: #8C8C8C;

    /* Cú pháp JSON ([FD §2.6]); dấu câu dùng màu chữ nên không có token. */
    --liveops-hub-json-key: #8FB8E8;
    --liveops-hub-json-string: #B5CEA8;
    --liveops-hub-json-number: #C8A2E0;
    --liveops-hub-json-literal: #7FC4C4;

    /* Màu phụ timeline ([FD §2.7]). */
    --liveops-hub-timeline-weekend: rgba(255, 255, 255, 0.03);
    --liveops-hub-timeline-today: rgba(44, 93, 135, 0.12);
    --liveops-hub-timeline-grid: rgba(255, 255, 255, 0.06);
    --liveops-hub-timeline-grid-monday: rgba(255, 255, 255, 0.14);

    /* Spacing ([FD §2.8]) — nhịp chính 8px; USS không có gap nên dùng làm margin của phần tử đứng sau. */
    --liveops-hub-space-2: 2px;
    --liveops-hub-space-4: 4px;
    --liveops-hub-space-6: 6px;
    --liveops-hub-space-8: 8px;
    --liveops-hub-space-10: 10px;
    --liveops-hub-space-12: 12px;
    --liveops-hub-space-16: 16px;
}

.liveops-hub-root.liveops-hub--skin-light {
    --liveops-hub-color-blocked-text: #780000;
    --liveops-hub-color-blocked-fill: #A80000;
    --liveops-hub-color-warning-text: #4F3600;
    --liveops-hub-color-warning-fill: #6E4E00;
    /* Quiet Light. #555555 đời đầu chỉ 4,46:1 trên cửa sổ #C8C8C8 — thiếu bậc chữ thường; #4F4F4F đo ra 4,90:1 ở đó.
       (W10-12) Nhưng RAIL của skin sáng không phải nền cửa sổ: nó là --unity-colors-default-background #A5A5A5, tối hơn
       hẳn, và ở đó #4F4F4F chỉ còn 3,33:1. Chỗ đó có chữ thật: vòng rỗng "chưa kiểm" của rail vẽ bằng quiet, và cảnh đo
       thứ 9 (màn Kiểm lịch, KẾT QUẢ CŨ — thêm ở phiếu W10-07) là cảnh đầu tiên dựng ra trạng thái ấy, nên đây là nợ có
       sẵn vừa lộ ra chứ không phải lỗi mới. #393939 đo ra 4,69:1 trên rail, 6,90:1 trên cửa sổ và 7,26:1 trên nền thẻ
       #CBCBCB — vẫn là xám trung tính cùng tông, và vẫn nhạt hơn hẳn chữ nền tảng #090909 nên "quiet" còn đọc ra là quiet.
       Chữa ở MÀU GỐC chứ không ở riêng cái badge, đúng lối mà W10-03 đã đi với --liveops-hub-color-link (#1D5087 →
       #143A60, cũng vì nền chip/rail): một token lo hết mọi chỗ dùng, thay vì rải luật theo từng màn. */
    --liveops-hub-color-quiet: #393939;
    /* (W10-09) Skin sáng là chỗ TRƯỢT mà phiếu W10-09 đo được: hồi ấy viền lấy màu quiet, và quiet skin sáng lúc đó là
       #4F4F4F — × 0,7 trên cửa sổ #C8C8C8 hợp thành #737373 = 2,82:1, dưới bậc hình khối 3:1. Không chữa bằng cách hạ
       opacity của hàng (0,7 là mức mờ của thiết kế Hình 10b cho "hàng chưa khai báo") và không chữa bằng opacity: 1 trên
       con (opacity của tổ tiên nhân xuống, con không gỡ được): chữa bằng một token RIÊNG đủ tối để sống sót phép nhân.
       #444444 × 0,7 hợp thành #6C6C6C = 3,16:1.
       (W10-12, ghi sau) Phiếu W10-12 sau đó hạ quiet skin sáng xuống #393939 vì nền RAIL, nên hôm nay quiet × 0,7 đo ra
       3,54:1 — tức nếu viền còn dùng quiet thì cũng vừa đủ qua bậc. Token riêng vẫn ĐÚNG và vẫn giữ: quiet là màu CHỮ,
       nó được chỉnh theo bậc 4,5:1 trên những nền khác; lần sau ai nâng quiet cho sáng lên một nấc là viền hình khối lại
       tụt dưới 3:1 mà không có gì báo. Hai bậc khác nhau thì hai token khác nhau. */
    --liveops-hub-color-undeclared-border: #444444;
    /* (W10-03) #1D5087 cũ đạt bậc chữ trên nền CỬA SỔ #C8C8C8 nhưng chữ bấm được của chip asset nằm trên nền CHIP
       #A5A5A5 (--unity-colors-default-background của skin sáng), ở đó chỉ 3,34:1. #143A60 đo ra 4,73:1 trên nền chip
       và 6,96:1 trên nền cửa sổ. Giữ nguyên tông lam của bảng màu, chỉ hạ độ sáng đúng mức cần; focus đi cùng link
       như cả hai skin vẫn làm, để viền tiêu điểm và chữ liên kết không tách thành hai màu lam khác nhau. */
    --liveops-hub-color-focus: #143A60;
    --liveops-hub-color-link: #143A60;
    /* Skin sáng KHÔNG đổi: #090909 đúng bằng --unity-colors-default-text của skin sáng đo trên ảnh chụp, nên chữ nền
       tảng của skin sáng giữ nguyên diện mạo cũ. Khai literal chứ không var(--unity-colors-default-text) vì biến của
       Unity theo skin ĐANG CHẠY của Editor, không theo class skin — khai var() thì bảng token đo skin sáng sẽ đọc
       nhầm màu chữ của skin tối. */
    --liveops-hub-color-text: #090909;
    --liveops-hub-color-now: #1A1A1A;
    --liveops-hub-color-on-selection: #FFFFFF;
    --liveops-hub-color-blocked-tint: rgba(168, 0, 0, 0.16);
    --liveops-hub-color-warning-tint: rgba(110, 78, 0, 0.16);
    --liveops-hub-scrim-color: rgba(0, 0, 0, 0.45);

    --liveops-hub-event-color-0: #2F6DB5;
    --liveops-hub-event-color-1: #13798A;
    --liveops-hub-event-color-2: #1E7A60;
    --liveops-hub-event-color-3: #4F55C2;
    --liveops-hub-event-color-4: #7A45B5;
    --liveops-hub-event-color-5: #A23C8A;
    --liveops-hub-event-color-6: #4F6A82;
    --liveops-hub-event-color-7: #8A5A70;

    /* Dấu chú giải Light: dấu là bản âm của cửa sổ #C8C8C8 nên ở đây dấu TỐI hơn nền; đo 6,59 / 4,39 / 3,05:1. */
    --liveops-hub-legend-fixed: #3C3C3C;
    --liveops-hub-legend-recurring: #565656;
    --liveops-hub-legend-ended: #6E6E6E;

    /* Chuỗi và literal Light cũ (#3F6B28 3,75:1 · #1E6B6B 3,72:1) thiếu bậc chữ thường 4,5:1 trên cửa sổ #C8C8C8;
       hai màu dưới đây đo ra 5,13:1 và 5,23:1, vẫn giữ đúng sắc lục/lam-lục để mắt phân biệt được bốn nhóm cú pháp. */
    --liveops-hub-json-key: #1F4E8C;
    --liveops-hub-json-string: #31551E;
    --liveops-hub-json-number: #6A3D9A;
    --liveops-hub-json-literal: #175353;

    --liveops-hub-timeline-weekend: rgba(0, 0, 0, 0.05);
    --liveops-hub-timeline-today: rgba(58, 114, 176, 0.12);
    --liveops-hub-timeline-grid: rgba(0, 0, 0, 0.08);
    --liveops-hub-timeline-grid-monday: rgba(0, 0, 0, 0.18);
}
